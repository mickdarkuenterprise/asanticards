# ── Supabase ──────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key        # Never expose this client-side

# ── Paystack ──────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx   # Server-side secret key (also verifies webhook signatures)
# The website no longer needs the public key — payments are started on the server

# ── Cloudflare Turnstile (checkout bot check) ─────
TURNSTILE_SECRET_KEY=                              # Leave empty until the website has the matching site key

# ── Admin Auth ────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
ADMIN_EMAIL=admin@asanticards.com
ADMIN_PASSWORD_HASH=                               # Generated on first run (see README)

# ── Email (Resend) ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx             # resend.com → API Keys
EMAIL_FROM="ASA NTI Orders <orders@asanticards.com>"  # Domain must be verified in Resend

# ── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://asanticards.com               # Your Namecheap domain (for CORS)
